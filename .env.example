# LLM API Keys (Multi-Provider Cascade)
GOOGLE_API_KEY="your_google_gemini_api_key_here"
MISTRAL_API_KEY="your_mistral_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Optional integrations
HUGGINGFACEHUB_API_TOKEN=""
TAVILY_API_KEY=""

# FreeLLMAPI [TEST] - 34 free providers, 635 models, 7.4B tokens/month
# 1. Install & start: npx freellmapi
# 2. Copy your bearer token from the freellmapi dashboard
# 3. Set FREELLMAPI_ENABLED=true to activate as the primary provider
FREELLMAPI_ENABLED="false"
FREELLMAPI_BASE_URL="http://localhost:3000/v1"
FREELLMAPI_API_KEY="your_freellmapi_bearer_token_here"
